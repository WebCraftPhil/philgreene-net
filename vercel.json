{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/website-checkup",
      "destination": "/website-checkup/index.html"
    },
    {
      "source": "/website-checkup/",
      "destination": "/website-checkup/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
